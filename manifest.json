{
  "manifest_version": 2,
  "name": "Smart Markdown Copy",
  "version": "2.0",
  "description": "Copy styled text perfectly into Microsoft Word with enhanced formatting",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Smart Copy v2.0",
    "default_icon": "icon.png"
  },
  "commands": {
    "smart-copy": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Copy with Word styles"
    }
  }
}